datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String?
  applications  Application[]
  records       Record[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Application {
  id          String   @id @default(uuid())
  name        String
  description String?
  config      String   // Configuration JSON string (layout, entities, views, workflows)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  records     Record[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Record {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityName    String      // e.g. "customers", "orders"
  data          String      // Record fields JSON string (e.g. { "name": "John", "email": "john@email.com" })
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, entityName])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
